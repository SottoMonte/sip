<Column width="full" background="#ffffff" class="shadow-sm">
    <Row padding="8px,8%" background="#092f52" align="center" justify="between" class="flex-col gap-2 sm:flex-row">
        <Row spacing="18px"><Action type="link" route="mailto:info@sip-italia.com"><Row align="center" spacing="5px"><Icon name="bi-envelope-fill" color="#d9efff" /><Text size="12px" color="#d9efff">info@sip-italia.com</Text></Row></Action><Action type="link" route="tel:+393665391867"><Row align="center" spacing="5px"><Icon name="bi-telephone-fill" color="#d9efff" /><Text size="12px" color="#d9efff">+393665391867</Text></Row></Action></Row>
        <Text size="12px" color="#9ed4f5">Soluzioni professionali per il tuo punto vendita</Text>
    </Row>
    <Row padding="21px,8%" align="center" justify="between" spacing="25px" class="flex-col md:flex-row">
        <Action type="link" route="/"><Row align="center" spacing="10px"><Column width="46px" height="46px" align="center" justify="center" background="#e4f3ff" radius="medium"><Icon name="bi-gear-wide-connected" size="29px" color="#12609b" /></Column><Column spacing="0px"><Text size="31px" font="black" color="#0b4777" spacing="3px">S.I.P</Text><Text size="8px" color="#64748b" uppercase="true">Sistemi informatici professionali</Text></Column></Row></Action>
        <Action type="form" route="/shop/catalog" act="GET" width="min(575px, 100%)">
            <Row width="full" height="46px" border="1px,solid,#b8d6eb" radius="medium" padding="0,8px,0,15px" align="center" justify="between" background="#f8fbfe" class="focus-within:ring-2 focus-within:ring-[#68a7dd]">
                <Input type="search" name="q" placeholder="Cerca prodotti..." width="full" height="38px" border="0" background="transparent" color="#172033" />
                <Action type="submit" padding="8px" background="transparent"><Icon name="bi-search" color="#68a7dd" size="20px" /></Action>
            </Row>
        </Action>
        <Row spacing="18px" align="center">
            <Action type="link" route="/account" padding="8px,10px" radius="small" class="transition hover:bg-[#f1f7fc]">
                <Row align="center" spacing="7px"><Icon name="bi-person-fill" color="#172033" size="21px" /><Text color="#172033" font="bold" size="13px">Account</Text></Row>
            </Action>
            <Action type="link" route="/shop/cart" padding="8px,10px" radius="small" class="transition hover:bg-[#f1f7fc]">
                <Row align="center" spacing="7px"><Icon name="bi-cart3" color="#172033" size="21px" /><Text color="#172033" font="bold" size="13px">Carrello</Text></Row>
            </Action>
        </Row>
    </Row>
    <Row width="full" padding="15px,9%" background="#12609b" align="center" spacing="34px" class="flex-col md:flex-row">
        <Action type="link" route="/azienda"><Text color="#ffffff" font="bold">Azienda</Text></Action>
        <Column position="relative" class="group">
            <Action type="link" route="/shop" padding="8px,0"><Row align="center" spacing="5px"><Text color="#ffffff" font="bold">Shop</Text><Icon name="bi-chevron-down" color="#ffffff" size="11px" /></Row></Action>
            <Column position="absolute" top="40px" left="0" width="220px" padding="10px" background="#ffffff" radius="medium" shadow="large" border="1px,solid,#dce8f0" spacing="2px" class="hidden group-hover:flex z-50">
                <Action type="link" route="/shop/bilance" padding="10px,12px" class="rounded hover:bg-[#f1f7fc]"><Row align="center" spacing="8px"><Icon name="bi-speedometer2" color="#12609b" /><Text color="#12609b" size="14px">Bilance</Text></Row></Action>
                <Action type="link" route="/shop/attrezzature" padding="10px,12px" class="rounded hover:bg-[#f1f7fc]"><Row align="center" spacing="8px"><Icon name="bi-shop-window" color="#12609b" /><Text color="#12609b" size="14px">Attrezzature</Text></Row></Action>
                <Action type="link" route="/shop/software" padding="10px,12px" class="rounded hover:bg-[#f1f7fc]"><Row align="center" spacing="8px"><Icon name="bi-grid-1x2" color="#12609b" /><Text color="#12609b" size="14px">Casse e software</Text></Row></Action>
                <Action type="link" route="/shop/accessori" padding="10px,12px" class="rounded hover:bg-[#f1f7fc]"><Row align="center" spacing="8px"><Icon name="bi-tools" color="#12609b" /><Text color="#12609b" size="14px">Accessori</Text></Row></Action>
            </Column>
        </Column>
        <Action type="link" route="/assistenza"><Text color="#ffffff" font="bold">Assistenza</Text></Action>
        <Action type="link" route="/news"><Text color="#ffffff" font="bold">News</Text></Action>
        <Action type="link" route="/contatti"><Text color="#ffffff" font="bold">Contatti</Text></Action>
        <Action type="link" route="https://wa.me/393665391867" background="#25d366" radius="full" padding="8px,14px" class="md:ml-auto"><Row align="center" spacing="6px"><Icon name="bi-whatsapp" color="#ffffff" /><Text color="#ffffff" font="bold" size="14px">Whatsapp</Text></Row></Action>
    </Row>
</Column>

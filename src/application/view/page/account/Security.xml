{% extends "Layout.xml" %}
{% block title %}Sicurezza account - SIP Italia{% endblock %}
{% block content %}
<Column padding="60px,9%" spacing="25px" background="#f8fbfe"><Column spacing="6px"><Text color="#68a7dd" font="bold" uppercase="true">Account</Text><Text type="h1" size="36px" font="black" color="#12609b">Sicurezza</Text><Text color="#64748b">Proteggi il tuo account con una password sicura.</Text></Column><Column width="full" background="#ffffff" padding="26px" radius="medium" border="1px,solid,#e2e8f0" spacing="16px"><Action type="form" route="/account/security" act="POST" spacing="14px"><Input type="password" name="current_password" placeholder="Password attuale" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /><Input type="password" name="new_password" placeholder="Nuova password" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /><Input type="password" name="confirm_password" placeholder="Conferma nuova password" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /><Action type="submit" background="#12609b" radius="small" padding="13px,20px"><Text color="#ffffff" font="bold">Aggiorna password</Text></Action></Action></Column></Column>
{% endblock %}

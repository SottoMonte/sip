{% extends "Layout.xml" %}
{% block title %}Il mio account - SIP Italia{% endblock %}
{% block breadcrumb_label %}Account{% endblock %}
{% block content %}
<Column padding="60px,9%" spacing="28px" background="#f8fbfe"><Column spacing="8px"><Text color="#68a7dd" font="bold" uppercase="true">Area personale</Text><Text type="h1" size="42px" font="black" color="#12609b">Ciao, benvenuto nel tuo account.</Text><Text color="#64748b" size="17px">Gestisci ordini, dati personali e preferenze in un unico spazio.</Text></Column><Grid spacing="18px" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));"><Action type="link" route="/account/orders" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0" class="transition hover:-translate-y-1"><Icon name="bi-box-seam" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">I miei ordini</Text><Text color="#64748b">Controlla stato e storico degli acquisti.</Text></Action><Action type="link" route="/account/profile" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0" class="transition hover:-translate-y-1"><Icon name="bi-person-vcard" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Dati personali</Text><Text color="#64748b">Modifica contatti e informazioni.</Text></Action><Action type="link" route="/account/addresses" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0" class="transition hover:-translate-y-1"><Icon name="bi-geo-alt" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Indirizzi</Text><Text color="#64748b">Gestisci spedizione e fatturazione.</Text></Action><Action type="link" route="/account/security" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0" class="transition hover:-translate-y-1"><Icon name="bi-shield-lock" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Sicurezza</Text><Text color="#64748b">Password e protezione dell’account.</Text></Action></Grid></Column>
{% endblock %}

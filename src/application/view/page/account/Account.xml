{% extends "Layout.xml" %}
{% block title %}Il mio account - SIP Italia{% endblock %}
{% block breadcrumb_label %}Account{% endblock %}
{% block content %}
<Column padding="60px,9%" spacing="28px" background="#f8fbfe"><Column spacing="8px"><Text color="#68a7dd" font="bold" uppercase="true">Area personale</Text><Text type="h1" size="42px" font="black" color="#12609b">Ciao, benvenuto nel tuo account.</Text><Text color="#64748b" size="17px">Gestisci ordini, assistenza, documenti e prodotti in tuo possesso.</Text></Column><Grid spacing="18px" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));"><Action type="link" route="/account/orders" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0" class="transition hover:-translate-y-1"><Icon name="bi-box-seam" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">I miei ordini</Text><Text color="#64748b">Controlla stato e storico degli acquisti.</Text></Action><Action type="link" route="/account/inventory" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-boxes" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">I miei prodotti</Text><Text color="#64748b">Inventario, garanzie e scadenze.</Text></Action><Action type="link" route="/account/tickets" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-headset" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Ticket assistenza</Text><Text color="#64748b">Apri e monitora le richieste.</Text></Action><Action type="link" route="/account/bookings" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-calendar-check" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Prenotazioni</Text><Text color="#64748b">Interventi e appuntamenti.</Text></Action><Action type="link" route="/account/documents" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-file-earmark-text" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Documenti</Text><Text color="#64748b">Fatture, manuali e certificati.</Text></Action><Action type="link" route="/account/returns" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-arrow-return-left" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Resi e rimborsi</Text><Text color="#64748b">Gestisci richieste e stato dei resi.</Text></Action><Action type="link" route="/account/profile" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-person-vcard" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Dati personali</Text><Text color="#64748b">Modifica contatti e informazioni.</Text></Action><Action type="link" route="/account/addresses" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-geo-alt" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Indirizzi</Text><Text color="#64748b">Gestisci spedizione e fatturazione.</Text></Action><Action type="link" route="/account/security" background="#ffffff" padding="25px" radius="medium" border="1px,solid,#e2e8f0"><Icon name="bi-shield-lock" size="28px" color="#68a7dd" /><Text color="#12609b" font="black" size="20px">Sicurezza</Text><Text color="#64748b">Password e protezione dell’account.</Text></Action></Grid></Column>
{% endblock %}

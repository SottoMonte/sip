{% extends "Layout.xml" %}
{% block title %}Dati personali - SIP Italia{% endblock %}
{% block content %}
<Column padding="60px,9%" spacing="25px" background="#f8fbfe"><Column spacing="6px"><Text color="#68a7dd" font="bold" uppercase="true">Account</Text><Text type="h1" size="36px" font="black" color="#12609b">Dati personali</Text><Text color="#64748b">Tieni aggiornate le informazioni del tuo profilo.</Text></Column><Column width="full" background="#ffffff" padding="26px" radius="medium" border="1px,solid,#e2e8f0" spacing="16px"><Action type="form" route="/account/profile" act="POST" spacing="14px"><Row spacing="14px" class="flex-col sm:flex-row"><Input type="text" name="first_name" value="Mario" placeholder="Nome" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /><Input type="text" name="last_name" value="Rossi" placeholder="Cognome" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /></Row><Input type="email" name="email" value="mario.rossi@example.com" placeholder="Email" required="true" width="full" border="1px,solid,#cbdceb" padding="13px" /><Input type="tel" name="phone" value="+39 366 539 1867" placeholder="Telefono" width="full" border="1px,solid,#cbdceb" padding="13px" /><Action type="submit" background="#12609b" radius="small" padding="13px,20px"><Text color="#ffffff" font="bold">Salva modifiche</Text></Action></Action></Column></Column>
{% endblock %}

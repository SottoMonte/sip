{% set segments = session.current_url.path | default([]) %}
{% set labels = {
    "shop": "Shop",
    "catalog": "Catalogo",
    "catalogo": "Catalogo",
    "product": "Prodotto",
    "cart": "Carrello",
    "checkout": "Checkout",
    "order": "Ordine",
    "confirmation": "Ordine confermato",
    "account": "Account",
    "profile": "Dati personali",
    "addresses": "Indirizzi",
    "security": "Sicurezza",
    "tickets": "Ticket assistenza",
    "bookings": "Prenotazioni",
    "documents": "Documenti",
    "inventory": "I miei prodotti",
    "returns": "Resi e rimborsi",
    "login": "Accedi",
    "orders": "I miei ordini",
    "azienda": "Azienda",
    "assistenza": "Assistenza",
    "news": "News",
    "contatti": "Contatti"
} %}

{% if segments %}
<Row width="full" padding="13px,9%" background="#ffffff" align="center" spacing="12px" border="1px,solid,#e5edf5" class="shadow-sm">
    <Action type="link" route="/"><Text color="#12609b" font="bold" size="13px"><Icon name="bi-house-door" /> </Text><Text color="#12609b" font="bold" size="13px">Home</Text></Action>
    {% set breadcrumb = namespace(url="") %}
    {% for segment in segments %}
        {% set breadcrumb.url = breadcrumb.url ~ "/" ~ segment %}
        <Text color="#94a3b8">›</Text>
        {% if loop.last %}
            <Text color="#172033" font="bold" size="13px">{{ labels.get(segment, segment | replace("-", " ") | title) }}</Text>
        {% else %}
            <Action type="link" route="{{ breadcrumb.url }}"><Text color="#12609b" font="bold" size="13px">{{ labels.get(segment, segment | replace("-", " ") | title) }}</Text></Action>
        {% endif %}
    {% endfor %}
</Row>
{% else %}
<Column width="full" height="0px" />
{% endif %}
